	<key>donation-reminder-card-body</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Am %1$@ hast du uns gebeten, dich nach dem Lesen von %2$#@v2@ ans Spenden zu erinnern. Wenn dir Wikipedia Wissen im Wert von %3$@ gebracht hat, schließe dich den 2 %% der Leser an, die spenden, und löse dein Versprechen heute ein.</string>
