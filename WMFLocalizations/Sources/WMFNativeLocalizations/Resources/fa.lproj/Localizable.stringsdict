	<key>microsite-yir-english-edits-bytes-slide-subtitle-updated</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>در سال %1$@، داوطلبان %2$#@v2@ به ویکی‌پدیای انگلیسی اضافه کردند. مجموع تمام کارهای آنها با هم منجر به یک منبع دانش مبتنی بر واقعیت و قابل اعتماد می‌شود که به طور پیوسته در حال بهبود است و به جهان ارائه می‌شود. همه ما دانشی برای به اشتراک گذاشتن داریم، [یاد بگیرید چگونه مشارکت کنید](%3$@).</string>
		<key>v2</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>بایت</string>
		</dict>
	</dict>
