require 'json'
require_relative 'xcode_cloud'

default_platform(:ios)

platform :ios do

  # Shared helper: build API key object from env vars
  def get_api_key
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_ISSUER_ID"],
      key_content: ENV["APP_STORE_API_KEY"],
      in_house: false
    )
  end

  # Shared helper: list all certificate IDs currently on the account, regardless
  # of type. Used to detect byproduct certs created by automatic signing +
  # -allowProvisioningUpdates on ephemeral CI runners (see cleanup_dev_cert_byproducts).
  def all_certificate_ids
    Spaceship::ConnectAPI::Certificate.all.map(&:id)
  end

  # Shared helper: delete any certificate created since before_cert_ids was
  # captured, as long as it's a Development-type cert. Automatic signing +
  # -allowProvisioningUpdates mints a fresh Development certificate as a
  # byproduct on every run, since GitHub-hosted runners are ephemeral and
  # never have an existing one locally - left unchecked this eats into the
  # account's certificate quota over time. Anything unexpected (e.g. a
  # Distribution cert created by someone else mid-run) is left alone.
  def cleanup_dev_cert_byproducts(before_cert_ids)
    all_certs_after = Spaceship::ConnectAPI::Certificate.all
    new_certs = all_certs_after.select { |c| !before_cert_ids.include?(c.id) }
    if new_certs.empty?
      UI.message("No new certificates detected during this run.")
    end
    deletable_types = ["DEVELOPMENT", "IOS_DEVELOPMENT"]
    new_certs.each do |cert|
      unless deletable_types.include?(cert.certificate_type)
        UI.important("Skipping new certificate of unexpected type, not deleting: #{cert.display_name} (type: #{cert.certificate_type})")
        next
      end
      cert.delete!
      UI.success("Deleted byproduct certificate: #{cert.display_name} (type: #{cert.certificate_type})")
    end
  end

  # Shared helper: What to Test notes for an external beta, by locale, from
  # the JSON the Beta workflow writes. There is always a "default" entry.
  def beta_localized_build_info
    localized_notes = JSON.parse(File.read("/tmp/what_to_test.json")) rescue {}
    localized_build_info = localized_notes.transform_values { |notes| { whats_new: notes } }
    unless localized_build_info.key?("default")
      default_notes = localized_notes["en-US"] || "See release notes for details"
      localized_build_info["default"] = { whats_new: default_notes }
    end
    localized_build_info
  end

  # Shared helper: build the app. Defaults to the production Wikipedia
  # scheme; the Alpha build passes its own scheme/configuration.
  def build_the_app(scheme: "Wikipedia", configuration: "Release", archive_name: "Wikipedia")
    build_app(
      project: "Wikipedia.xcodeproj",
      scheme: scheme,
      configuration: configuration,
      derived_data_path: "build",
      destination: "generic/platform=iOS",
      archive_path: "build/#{archive_name}.xcarchive",
      export_method: "app-store",
      include_symbols: true,
      xcargs: "-allowProvisioningUpdates -authenticationKeyPath #{ENV['APP_STORE_KEY_PATH']} -authenticationKeyID #{ENV['APP_STORE_API_KEY_ID']} -authenticationKeyIssuerID #{ENV['APP_STORE_ISSUER_ID']}",
    )
  end

  # ----------------------------------------------------------
  # Workflow 1: Internal TestFlight
  # ----------------------------------------------------------
  desc "Build and deploy to internal TestFlight testers"
  lane :internal_beta do
    api_key = get_api_key
    before_cert_ids = all_certificate_ids

    build_the_app

    what_to_test = File.read(ENV["WHAT_TO_TEST_PATH"]) rescue "See Phabricator tasks for details"

    upload_to_testflight(
      api_key: api_key,
      distribute_external: false,
      notify_external_testers: false,
      changelog: what_to_test,
      skip_waiting_for_build_processing: true,
    )

    cleanup_dev_cert_byproducts(before_cert_ids)
  end

  # ----------------------------------------------------------
  # Workflow 1b: Alpha (v2_deploy_alpha)
  #
  # Builds the Alpha scheme rather than the production Wikipedia scheme.
  # Runs alongside internal_beta above while the v2 workflows are tested.
  # ----------------------------------------------------------
  desc "Build the Alpha app and deploy to internal TestFlight testers"
  lane :alpha do
    api_key = get_api_key
    before_cert_ids = all_certificate_ids

    build_the_app(
      scheme: "Alpha",
      configuration: "Alpha",
      archive_name: "Wikipedia-Alpha",
    )

    what_to_test = File.read(ENV["WHAT_TO_TEST_PATH"]) rescue "See Phabricator tasks for details"

    upload_to_testflight(
      api_key: api_key,
      app_identifier: "org.wikimedia.wikipedia.tfbeta",
      distribute_external: false,
      notify_external_testers: false,
      changelog: what_to_test,
      skip_waiting_for_build_processing: true,
    )

    cleanup_dev_cert_byproducts(before_cert_ids)
  end

  # ----------------------------------------------------------
  # Workflow 1c: builds on Xcode Cloud
  #
  # Runs on Linux. Starts an Xcode Cloud workflow on a branch through the App
  # Store Connect API and waits for it, so the archive never takes a macOS
  # runner. Used by V2 Deploy Alpha ("Alpha Build", ALPHA_BUILDER) and by
  # V2 Deploy Hotfix ("Beta Build", RELEASE_BUILDER). Those Xcode Cloud
  # workflows keep their own start condition set to manual: only these lanes
  # start them, so the repository variables are the one switch between the
  # Mac and Xcode Cloud paths.
  #
  # Xcode Cloud owns the build number (CI_BUILD_NUMBER) and the version, both
  # set by ci_scripts/ci_pre_xcodebuild.sh, and pushes the build's tag itself
  # (ci_scripts/tag_script_xcodebuild.sh), so these lanes only report what was
  # built. Notes are set afterwards by testflight_what_to_test, once the
  # workflow has worked them out.
  # ----------------------------------------------------------
  def xcode_cloud_client
    XcodeCloud::Client.new(
      key_id: ENV["APP_STORE_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_ISSUER_ID"],
      key: ENV["APP_STORE_API_KEY"],
      log: ->(message) { UI.message(message) },
    )
  end

  def write_github_outputs(values)
    values.each { |key, value| UI.message("#{key}=#{value}") }
    path = ENV["GITHUB_OUTPUT"].to_s
    return if path.empty?
    File.open(path, "a") { |f| values.each { |key, value| f.puts("#{key}=#{value}") } }
  end

  def env_or(name, default)
    ENV[name].to_s.empty? ? default : ENV[name]
  end

  # Starts workflow_name on branch, waits for it and writes sha, version,
  # build and build_id to the step's outputs. tag_prefix is the tag Xcode
  # Cloud will push for this workflow (alphas, betas), used to catch a stale
  # build counter. expected_version, when given, fails the run if the build
  # came out with any other version.
  def xcode_cloud_build(app_identifier:, workflow_name:, branch:, tag_prefix:, expected_version: nil, reference_wait: 0)
    client = xcode_cloud_client

    app_id = client.app_id(app_identifier)
    product_id = client.product_id(app_id)
    workflow_id = client.workflow_id(product_id, workflow_name)
    reference_id = client.git_reference_id(workflow_id, "refs/heads/#{branch}", wait: reference_wait)
    UI.message("Workflow #{workflow_name.inspect} (#{workflow_id}), branch #{branch} (#{reference_id})")

    if ENV["XCODE_CLOUD_LOOKUP_ONLY"] == "true"
      UI.success("Lookups succeeded; not starting a build")
      return
    end

    # Read before starting, so a tag the build pushes cannot count against it.
    highest_tag = `git tag --list '#{tag_prefix}/*'`.lines.map { |t| t.strip.delete_prefix("#{tag_prefix}/") }
                                                   .grep(/\A\d+\z/).map(&:to_i).max

    run = client.start_build_run(workflow_id: workflow_id, git_reference_id: reference_id)
    number = run.dig("attributes", "number")
    UI.message("Started Xcode Cloud build #{number} (run #{run['id']})")

    # Xcode Cloud numbers builds from its own counter, which only a person
    # can change. If it is behind our tags, the build would archive and then
    # fail pushing a tag that already exists - say so now, not ten minutes
    # from now. The build already started cannot be stopped through the API.
    if number && highest_tag && number.to_i <= highest_tag
      UI.user_error!(
        "Xcode Cloud assigned build #{number}, but #{tag_prefix}/#{highest_tag} already exists, so the build will fail at its tag push. " \
        "Set the next build number above #{highest_tag} in App Store Connect > the #{app_identifier} app > Xcode Cloud > Settings > Build Number, then re-run. See docs/ci.md."
      )
    end

    logs_dir = env_or("XCODE_CLOUD_LOGS_DIR", nil)
    run = client.wait_for_build_run(run["id"], timeout: 90 * 60, logs_dir: logs_dir)
    sha = run.dig("attributes", "sourceCommit", "commitSha")
    build = client.produced_build(run["id"])
    UI.success("Xcode Cloud built #{sha}: TestFlight #{build[:version]} (#{build[:build_number]})")

    write_github_outputs(
      sha: sha,
      version: build[:version],
      build: build[:build_number],
      build_id: build[:id],
    )

    # ci_pre_xcodebuild.sh takes a release's version from its branch name. If
    # that went wrong the build is already in TestFlight under the wrong
    # version, so stop before anything announces it.
    if expected_version && build[:version] != expected_version
      UI.user_error!(
        "Xcode Cloud built version #{build[:version]}, expected #{expected_version}. " \
        "Check that the branch is #{branch} and that ci_scripts/ci_pre_xcodebuild.sh read its version. " \
        "Build #{build[:build_number]} is in TestFlight (internal only) under the wrong version and is tagged #{tag_prefix}/#{build[:build_number]}."
      )
    end
  end

  desc "Start the Xcode Cloud Alpha Build on a branch (default main) and wait for it"
  lane :xcode_cloud_alpha do
    xcode_cloud_build(
      app_identifier: "org.wikimedia.wikipedia.tfbeta",
      workflow_name: env_or("XCODE_CLOUD_WORKFLOW", "Alpha Build"),
      branch: env_or("BRANCH", "main"),
      tag_prefix: "alphas",
    )
  end

  desc "Start the Xcode Cloud Beta Build (production app) on BRANCH and wait for it"
  lane :xcode_cloud_release do
    branch = ENV["BRANCH"].to_s
    UI.user_error!("BRANCH is required") if branch.empty?
    xcode_cloud_build(
      app_identifier: "org.wikimedia.wikipedia",
      workflow_name: env_or("XCODE_CLOUD_WORKFLOW", "Beta Build"),
      branch: branch,
      tag_prefix: "betas",
      expected_version: env_or("EXPECTED_VERSION", nil),
      # V2 Deploy Beta pushes a new release candidate branch just before this.
      reference_wait: 300,
    )
  end

  def set_what_to_test_from_file
    build_id = ENV["BUILD_ID"].to_s
    UI.user_error!("BUILD_ID is required") if build_id.empty?
    notes = File.read(ENV["WHAT_TO_TEST_PATH"]) rescue "See Phabricator tasks for details"

    client = xcode_cloud_client
    client.wait_for_build_processing(build_id)
    client.set_what_to_test(build_id, notes)
    UI.success("Set What to Test on build #{build_id}")
  end

  desc "Wait for a TestFlight build to finish processing, then set its What to Test notes"
  lane :testflight_what_to_test do
    set_what_to_test_from_file
  end

  desc "Same as testflight_what_to_test (kept for V2 Deploy Alpha)"
  lane :alpha_what_to_test do
    set_what_to_test_from_file
  end

  # ----------------------------------------------------------
  # Workflow 2: External TestFlight
  # ----------------------------------------------------------
  desc "Build and deploy to external TestFlight testers, submit for beta review"
  lane :external_beta do
    api_key = get_api_key
    before_cert_ids = all_certificate_ids

    build_the_app

    # Read localized notes from JSON file written by workflow
    localized_notes = JSON.parse(File.read("/tmp/what_to_test.json")) rescue {}

    # Build localized_build_info hash
    localized_build_info = localized_notes.transform_values do |notes|
      { whats_new: notes }
    end

    # Ensure there's always a default
    unless localized_build_info.key?("default")
      default_notes = localized_notes["en-US"] || "See release notes for details"
      localized_build_info["default"] = { whats_new: default_notes }
    end

    upload_to_testflight(
      api_key: api_key,
      distribute_external: true,
      notify_external_testers: true,
      localized_build_info: localized_build_info,
      submit_beta_review: true,
      skip_waiting_for_build_processing: false,
      groups: ["External Testers"],
    )

    cleanup_dev_cert_byproducts(before_cert_ids)
  end

  # ----------------------------------------------------------
  # Workflow 2b: Beta (v2_deploy_beta)
  #
  # Same upload as external_beta above - it differs only in which commit
  # the workflow builds from (a release candidate branch). Runs alongside
  # external_beta while the v2 workflows are tested.
  # ----------------------------------------------------------
  desc "Build and deploy a release candidate to external TestFlight testers"
  lane :beta do
    api_key = get_api_key
    before_cert_ids = all_certificate_ids

    build_the_app

    upload_to_testflight(
      api_key: api_key,
      distribute_external: true,
      notify_external_testers: true,
      localized_build_info: beta_localized_build_info,
      submit_beta_review: true,
      skip_waiting_for_build_processing: false,
      groups: ["External Testers"],
    )

    cleanup_dev_cert_byproducts(before_cert_ids)
  end

  # ----------------------------------------------------------
  # Workflow 2c: Beta on Xcode Cloud (v2_deploy_beta, RELEASE_BUILDER=xcode-cloud)
  #
  # Same distribution as beta above, for a build Xcode Cloud has already
  # uploaded (its Beta Build workflow distributes to internal testers only).
  # Runs on Linux: distribute_only talks to the App Store Connect API and
  # needs no archive or macOS tooling.
  # ----------------------------------------------------------
  desc "Distribute an uploaded build (VERSION, BUILD_NUMBER) to external TestFlight testers, submit for beta review"
  lane :distribute_beta do
    version = ENV["VERSION"].to_s
    build_number = ENV["BUILD_NUMBER"].to_s
    build_id = ENV["BUILD_ID"].to_s
    UI.user_error!("VERSION and BUILD_NUMBER are required") if version.empty? || build_number.empty?

    # pilot waits for processing on upload, not on distribute_only.
    xcode_cloud_client.wait_for_build_processing(build_id) unless build_id.empty?

    upload_to_testflight(
      api_key: get_api_key,
      distribute_only: true,
      app_platform: "ios",
      app_version: version,
      build_number: build_number,
      distribute_external: true,
      notify_external_testers: true,
      localized_build_info: beta_localized_build_info,
      submit_beta_review: true,
      groups: ["External Testers"],
    )
  end

  # ----------------------------------------------------------
  # Workflow 3: App Store submission
  # ----------------------------------------------------------
  desc "Build and submit to App Store Review"
  lane :submit_for_review do
    api_key = get_api_key
    before_cert_ids = all_certificate_ids

    build_the_app

    should_submit = ENV["SUBMIT_FOR_REVIEW"] == "true"

    upload_to_app_store(
      api_key: api_key,
      app_version: ENV["VERSION"],
      submit_for_review: should_submit,
      automatic_release: false,
      phased_release: true,
      reset_ratings: false,
      force: true,
      precheck_include_in_app_purchases: false,
      skip_screenshots: true,
      skip_metadata: false,
      metadata_path: "fastlane/metadata",
    )

    cleanup_dev_cert_byproducts(before_cert_ids)
  end

  # ----------------------------------------------------------
  # Workflow 3b: App Store submission (v2_submit_appstore)
  #
  # Unlike submit_for_review above, this builds nothing - it submits a build
  # v2_deploy_beta already uploaded to TestFlight. Because nothing is built
  # here, a missing or still-processing build has to fail loudly rather than
  # let the submission pick up something unexpected.
  # ----------------------------------------------------------
  desc "Verify a version/build pair already exists in TestFlight"
  lane :verify_testflight_build do
    # app_store_connect_api_key authenticates Spaceship globally
    # (set_spaceship_token defaults to true), so the lookups below work
    # off the same credentials as the submission itself.
    get_api_key

    version = ENV["VERSION"].to_s
    build_number = ENV["BUILD_NUMBER"].to_s
    UI.user_error!("VERSION is required") if version.empty?
    UI.user_error!("BUILD_NUMBER is required") if build_number.empty?

    # The production app, per the app_identifier in fastlane/Appfile - the
    # same one the Beta workflow uploads to.
    app_identifier = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    app = Spaceship::ConnectAPI::App.find(app_identifier)
    UI.user_error!("Could not find app #{app_identifier} on this account") if app.nil?

    # Build.all maps :version onto the marketing version
    # (preReleaseVersion.version) and :build_number onto CFBundleVersion.
    build = Spaceship::ConnectAPI::Build.all(
      app_id: app.id,
      version: version,
      build_number: build_number,
    ).first

    if build.nil?
      available = Spaceship::ConnectAPI::Build.all(app_id: app.id, version: version).map(&:version)
      detail = if available.empty?
        "No builds exist in TestFlight for version #{version} at all."
      else
        "Build numbers present for #{version}: #{available.join(', ')}."
      end
      UI.user_error!(
        "No TestFlight build #{version} (#{build_number}) found. #{detail} " \
        "Run the Beta workflow to upload it before submitting."
      )
    end

    UI.success("Found TestFlight build #{version} (#{build_number}), state: #{build.processing_state}")

    unless build.processing_state == "VALID"
      UI.user_error!(
        "Build #{version} (#{build_number}) is in state #{build.processing_state}, not VALID. " \
        "Wait for App Store Connect to finish processing it before submitting."
      )
    end
  end

  desc "Submit an existing TestFlight build to App Store Review"
  lane :submit_appstore do
    api_key = get_api_key

    should_submit = ENV["SUBMIT_FOR_REVIEW"] == "true"

    # skip_binary_upload means deliver selects the already-uploaded build
    # identified by app_version/build_number instead of archiving one.
    upload_to_app_store(
      api_key: api_key,
      app_version: ENV["VERSION"],
      build_number: ENV["BUILD_NUMBER"],
      skip_binary_upload: true,
      submit_for_review: should_submit,
      automatic_release: false,
      phased_release: true,
      reset_ratings: false,
      force: true,
      precheck_include_in_app_purchases: false,
      skip_screenshots: true,
      skip_metadata: false,
      metadata_path: "fastlane/metadata",
    )
  end

  # ----------------------------------------------------------
  # Workflow 4: Design Review (Experimental app)
  # ----------------------------------------------------------
  desc "Build and deploy the Experimental app to internal TestFlight testers"
  lane :design_review do
    api_key = get_api_key
    before_cert_ids = all_certificate_ids

    build_app(
      project: "Wikipedia.xcodeproj",
      scheme: "Experimental",
      configuration: "Experimental",
      derived_data_path: "build",
      destination: "generic/platform=iOS",
      archive_path: "build/Wikipedia-Experimental.xcarchive",
      export_method: "app-store",
      include_symbols: true,
      xcargs: "-allowProvisioningUpdates -authenticationKeyPath #{ENV['APP_STORE_KEY_PATH']} -authenticationKeyID #{ENV['APP_STORE_API_KEY_ID']} -authenticationKeyIssuerID #{ENV['APP_STORE_ISSUER_ID']}",
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: "org.wikimedia.wikipedia.tfalpha",
      distribute_external: false,
      notify_external_testers: false,
      changelog: ENV["WHAT_TO_TEST"],
      skip_waiting_for_build_processing: true,
    )

    cleanup_dev_cert_byproducts(before_cert_ids)
  end

end
